{
  "name": "angular-portfolio",
  "version": "0.0.0",
  "engines": {
    "node": ">=20.19.0"
  },
  "scripts": {
    "ng": "ng",
    "start": "node scripts/sync-env.mjs && node scripts/generate-favicon.mjs && ng serve",
    "build": "node scripts/sync-env.mjs && node scripts/generate-favicon.mjs && ng build",
    "generate-favicon": "node scripts/generate-favicon.mjs",
    "update-from-cv": "node scripts/update-from-cv.mjs",
    "update-from-linkedin": "node scripts/update-from-cv.mjs --from-linkedin",
    "update-linkedin": "node scripts/update-from-cv.mjs --linkedin-only",
    "update-ar": "node scripts/update-from-cv.mjs --translate-ar",
    "update-photo": "node scripts/update-photo.mjs",
    "studio-photo": "node scripts/studio-photo.mjs",
    "export-content": "node scripts/export-content.mjs",
    "update-from-excel": "node scripts/update-from-excel.mjs",
    "watch": "ng build --watch --configuration development",
    "test": "ng test"
  },
  "prettier": {
    "printWidth": 100,
    "singleQuote": true,
    "overrides": [
      {
        "files": "*.html",
        "options": {
          "parser": "angular"
        }
      }
    ]
  },
  "private": true,
  "dependencies": {
    "@angular/common": "^20.3.0",
    "@angular/compiler": "^20.3.0",
    "@angular/core": "^20.3.0",
    "@angular/forms": "^20.3.0",
    "@angular/platform-browser": "^20.3.0",
    "@angular/router": "^20.3.0",
    "@vercel/speed-insights": "^2.0.0",
    "rxjs": "~7.8.0",
    "tslib": "^2.3.0",
    "zone.js": "~0.15.0"
  },
  "devDependencies": {
    "@angular/build": "^20.3.35",
    "@angular/cli": "^20.3.35",
    "@angular/compiler-cli": "^20.3.0",
    "@types/jasmine": "~5.1.0",
    "exceljs": "^4.4.0",
    "jasmine-core": "~5.9.0",
    "karma": "~6.4.0",
    "karma-chrome-launcher": "~3.2.0",
    "karma-coverage": "~2.2.0",
    "karma-jasmine": "~5.1.0",
    "karma-jasmine-html-reporter": "~2.1.0",
    "pdfjs-dist": "^6.3.289",
    "pngjs": "^7.0.0",
    "sharp": "^0.35.4",
    "typescript": "~5.9.2"
  }
}
